# ===========================================================================
# ModelRouter - OpenRouter Environment Variables
# ===========================================================================
# Copy this file to .env and input your OpenRouter API key.
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: HTTP Referer & App Title for OpenRouter rankings
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=ModelRouter

# Server Configuration
PORT=5000
FLASK_DEBUG=true
