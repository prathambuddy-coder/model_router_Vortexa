# A-01 ModelRouter — Environment Variables
# -----------------------------------------
# Copy this file to .env and fill in your keys.
# The backend works fully in simulation mode without any keys set.

# --- Cloud provider keys (optional) ---
# If not set, those models will return simulated responses.

GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Server config (optional) ---
PORT=5000
FLASK_DEBUG=true
